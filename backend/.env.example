# --- API ---
NODE_ENV=development
PORT=8080
LOG_LEVEL=info

# --- Auth ---
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=30d

# --- Database ---
DATABASE_URL=postgres://chirag:chirag@db:5432/jalsakhi
# OR break out:
PGHOST=db
PGPORT=5432
PGUSER=chirag
PGPASSWORD=chirag
PGDATABASE=jalsakhi

# --- Uploads ---
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=8

# --- Public base URL (for photo_url construction in responses) ---
PUBLIC_BASE_URL=http://localhost:8080
